# Allow selected result files
!alex/results/figures/*/*.png
!alex/results/videos/*/*.mp4
!alex/results/tables/**/*.csv
!alex/results/stationary/**/*.csv
!alex/results/stationary/**/*.png
!alex/results/newton/**/*.csv
!alex/results/newton/**/*.png
!alex/results/linear_stability/**/*.csv
!alex/results/linear_stability/**/*.png
!alex/results/linear_stability/**/*.mp4

