# Unified result layout.
alex/results/binaries/
alex/results/figures/*/frames/
alex/results/linear_stability/*/filtered_binaries/
alex/results/linear_stability/*/filtered_figures/frames/

# Paper-ready figures, videos, and CSV tables may be committed explicitly.
!alex/results/
!alex/results/binaries/
!alex/results/binaries/.gitkeep
!alex/results/figures/
!alex/results/figures/**/
!alex/results/figures/**/*.png
!alex/results/videos/
!alex/results/videos/**/
!alex/results/videos/**/*.mp4
!alex/results/tables/
!alex/results/tables/**/
!alex/results/tables/**/*.csv
!alex/results/stationary/
!alex/results/stationary/**/
!alex/results/stationary/.gitkeep
!alex/results/stationary/**/*.csv
!alex/results/stationary/**/*.png
!alex/results/newton/
!alex/results/newton/**/
!alex/results/newton/.gitkeep
!alex/results/newton/**/*.csv
!alex/results/newton/**/*.png
!alex/results/linear_stability/
!alex/results/linear_stability/**/
!alex/results/linear_stability/.gitkeep
