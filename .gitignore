# Build dirs
alex/build/
alex/cpu/build/

# Old generated outputs
alex/data/results/
alex/plots/
alex/linear_stability/filtered_results/
alex/linear_stability/plots/frames/
alex/linear_stability/videos/

# Heavy generated files by default
*.bin

# Generated animation frames: never commit
**/frames/
**/frames/**

# Result binaries
alex/results/binaries/
alex/results/linear_stability/*/filtered_binaries/

# Allow result root structure
!alex/results/
!alex/results/**/

# Allow paper-ready outputs
!alex/results/figures/**/*.png
!alex/results/videos/**/*.mp4
!alex/results/tables/**/*.csv
!alex/results/stationary/**/*.csv
!alex/results/stationary/**/*.png
!alex/results/newton/**/*.csv
!alex/results/newton/**/*.png
!alex/results/linear_stability/**/*.csv
!alex/results/linear_stability/**/*.png
!alex/results/linear_stability/**/*.mp4

# Final hard block for frames after allow-rules
alex/results/**/frames/
alex/results/**/frames/**
**/frames/*.png